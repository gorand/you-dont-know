      "id": "iso",
      "title": "ISO shapes",
      "narration": "Stadium (`start`, `queue`), rect + fork glyph (`decision`), Lucide cloud on a stadium. Ports stay on the box. Optional [[color-lock]].",
      "highlight": ["g-iso", "start", "process", "decision", "cloud", "queue"],
      "code": {
